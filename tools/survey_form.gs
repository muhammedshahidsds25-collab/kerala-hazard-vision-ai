/**
 * Google Form for the human evaluation (real vs AI-generated satellite images).
 *
 * 1. Run notebooks/04_evaluate.ipynb: it writes q01.png ... q21.png to
 *    MyDrive/kerala_hazard_vision_ai/outputs/human_eval/.
 * 2. Open script.google.com with the same Google account, create a new project, paste this file
 *    and run createSurveyForm. Approve the permissions, then copy the share link from the log.
 * 3. When the answers are in, run exportAnswers. It writes answers.csv next to the images, in
 *    the rater,item,answer format that human_eval.score_survey reads. Then run the scoring cell
 *    of notebook 04.
 *
 * Raters stay anonymous (rater1, rater2, ...), because answers.csv is committed to a public repo.
 */

const FOLDER_PATH = ['kerala_hazard_vision_ai', 'outputs', 'human_eval'];
const CHOICES = { 'Real satellite image': 'real', 'AI-generated': 'generated' };
const IMAGE_WIDTH = 400;

function surveyFolder_() {
  let folder = DriveApp.getRootFolder();
  for (const name of FOLDER_PATH) {
    const matches = folder.getFoldersByName(name);
    if (!matches.hasNext()) {
      throw new Error(`Folder ${FOLDER_PATH.join('/')} not found: run notebook 04 first.`);
    }
    folder = matches.next();
  }
  return folder;
}

function surveyImages_(folder) {
  const images = [];
  const files = folder.getFiles();
  while (files.hasNext()) {
    const file = files.next();
    if (/^q\d+\.png$/.test(file.getName())) images.push(file);
  }
  if (images.length === 0) throw new Error('No q*.png images in the survey folder.');
  return images.sort((a, b) => a.getName().localeCompare(b.getName()));
}

function createSurveyForm() {
  const form = FormApp.create('Real or AI-generated? Satellite images after disasters');
  form.setDescription(
    'Each image shows a 2.5 km area after a landslide or flood. Some are real Sentinel-2 ' +
      'satellite images, others were generated by AI. For each one, choose what you think it ' +
      'is. It takes about 5 minutes; no name needed.'
  );
  for (const file of surveyImages_(surveyFolder_())) {
    const item = file.getName().replace('.png', '');
    form.addImageItem().setTitle(item).setImage(file.getBlob()).setWidth(IMAGE_WIDTH);
    form
      .addMultipleChoiceItem()
      .setTitle(`${item}: real or AI-generated?`)
      .setChoiceValues(Object.keys(CHOICES))
      .setRequired(true);
  }
  PropertiesService.getScriptProperties().setProperty('FORM_ID', form.getId());
  Logger.log(`Share this link with raters: ${form.getPublishedUrl()}`);
  Logger.log(`Edit the form here: ${form.getEditUrl()}`);
}

function exportAnswers() {
  const formId = PropertiesService.getScriptProperties().getProperty('FORM_ID');
  if (!formId) throw new Error('Run createSurveyForm first.');

  const rows = [['rater', 'item', 'answer']];
  const responses = FormApp.openById(formId).getResponses();
  responses.forEach((response, index) => {
    for (const answer of response.getItemResponses()) {
      const item = answer.getItem().getTitle().split(':')[0];
      rows.push([`rater${index + 1}`, item, CHOICES[answer.getResponse()]]);
    }
  });

  const folder = surveyFolder_();
  const old = folder.getFilesByName('answers.csv');
  while (old.hasNext()) old.next().setTrashed(true); // keep exactly one answers.csv
  folder.createFile('answers.csv', rows.map((row) => row.join(',')).join('\n'), MimeType.CSV);
  Logger.log(`Wrote ${rows.length - 1} answers from ${responses.length} rater(s).`);
}
